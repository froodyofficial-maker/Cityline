<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>CpsOverlay</AssemblyName>
    <RootNamespace>CpsOverlay</RootNamespace>
    <Version>1.0.0</Version>
    <Product>CPS Overlay</Product>
    <Company>ProMouser</Company>
    <Description>CPS, ping and autoclicker check overlay. Made by ProMouser.</Description>
    <Copyright>Made by ProMouser</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
