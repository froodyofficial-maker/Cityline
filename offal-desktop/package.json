{
  "name": "offal-desktop",
  "productName": "OFFAL",
  "version": "1.0.0",
  "description": "OFFAL desktop app",
  "author": "OFFAL",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "node copy-game.cjs && electron .",
    "dist:win": "node copy-game.cjs && electron-builder --win portable zip --x64",
    "dist:linux": "node copy-game.cjs && electron-builder --linux AppImage --x64"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "games.offal.nightshift",
    "productName": "OFFAL",
    "artifactName": "OFFAL-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "release" },
    "files": ["main.cjs", "icon.png", "game/**"],
    "asar": true,
    "compression": "maximum",
    "win": { "icon": "icon.png", "signExecutable": false },
    "portable": { "artifactName": "OFFAL-${version}-portable.exe" },
    "linux": { "icon": "icon.png", "category": "Game" }
  }
}
