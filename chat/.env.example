# Copy this file to ".env" and fill in your Supabase project's values.
# Supabase dashboard → Project Settings → API  (or the "Connect" button)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: GIF picker (free key from https://developers.giphy.com)
VITE_GIPHY_API_KEY=

# Optional: a TURN server for voice/video behind strict firewalls
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
