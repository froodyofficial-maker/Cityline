{
  "name": "ember-city-desktop",
  "productName": "Ember City",
  "version": "2.3.0",
  "description": "Ember City desktop app",
  "author": "Ember City",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare-game": "node copy-game.cjs",
    "start": "node copy-game.cjs && electron .",
    "dist:win": "node copy-game.cjs && electron-builder --win portable zip --x64",
    "dist:linux": "node copy-game.cjs && electron-builder --linux AppImage --x64",
    "dist:mac": "node copy-game.cjs && electron-builder --mac zip"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "city.ember.game",
    "productName": "Ember City",
    "artifactName": "EmberCity-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "release" },
    "files": ["main.cjs", "icon.png", "game/**"],
    "asar": true,
    "compression": "maximum",
    "win": { "icon": "icon.png", "signExecutable": false },
    "portable": { "artifactName": "EmberCity-${version}-portable.exe" },
    "linux": { "icon": "icon.png", "category": "Game" },
    "mac": { "icon": "icon.png", "category": "public.app-category.games" }
  }
}
